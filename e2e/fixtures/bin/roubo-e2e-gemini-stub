#!/usr/bin/env node

// Stub agent CLI for the `gemini-cli` e2e overlay (issue #534).
//
// The overlay (../bundled-overlays/gemini-cli/) points its manifest-declared
// version probe and its launch descriptor at this binary. It exists so the
// marketplace listing's compatibility window resolves against something real and
// so AP-TC-115 S007 can open a live PTY session for an agent that is not Claude
// Code.
//
// Deliberately NOT named `gemini`: `importLoginShellEnv()` prepends `~/.local/bin`
// to the server's PATH, so a real Gemini CLI install on a developer machine
// would win the lookup and the harness would drive that binary instead.
//
// Two behaviours, keyed on argv:
//
//   --version   print a version inside the overlay's declared compatibility
//               window and exit 0, so the card resolves `within-tested-range`
//               and any launch passes the pre-launch gate.
//   otherwise   print a ready line and idle so the PTY session stays live and
//               the host classifies no early-exit failure.
//
// Like roubo-e2e-codex-stub and unlike roubo-e2e-claude-stub, this binary NEVER
// writes AGENT_ARGV_LOG_PATH. That log is a single shared file the AP-TC-087
// guard reads as evidence of the argv its own launch produced; a second writer
// could only race it or clobber it.

// Inside the overlay's declared window (floor 0.9.0, tested ceiling 1.2.3, which
// is AP-TC-115 S002's worked example verbatim), so the gate neither blocks a
// launch nor emits a staleness notice. The trailing marker keeps a stray real
// invocation legible in a log.
const STUB_VERSION = "1.1.0";

const argv = process.argv.slice(2);

if (argv.includes("--version")) {
  process.stdout.write(`gemini-cli ${STUB_VERSION} (Roubo e2e stub)\n`);
  process.exit(0);
}

// A line of output so the session reads as a live agent rather than a silent
// one, and so the early-exit classifier has captured output to work with if this
// process ever does die.
process.stdout.write("roubo-e2e-gemini-stub ready\n");

// Idle. The spec destroys the session when it is done, and the timer is the only
// handle keeping the event loop alive, so an unref'd or cleared timer would end
// the process.
const keepAlive = setInterval(() => {}, 1000);

for (const signal of ["SIGTERM", "SIGINT", "SIGHUP"]) {
  process.on(signal, () => {
    clearInterval(keepAlive);
    process.exit(0);
  });
}
