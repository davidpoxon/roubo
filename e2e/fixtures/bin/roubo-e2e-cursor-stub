#!/usr/bin/env node

// Stub agent CLI for the `cursor-cli` e2e overlay (APCC-TC-038, APCC-TC-011,
// APCC-TC-046, APCC-TC-031, APCC-TC-056).
//
// The overlay (../bundled-overlays/cursor-cli/) points its manifest-declared
// version probe, its `model` choice probe and its launch descriptor at this
// binary. The APCC-TC-038 journey launches a Cursor session in a bench and reads
// back the argv the spawned child actually received, posture flags included; the
// APCC-TC-011 journey fills the model field from the probe, then does the same;
// the APCC-TC-046 journey finishes a turn and watches the notification it raises;
// the APCC-TC-031 journey reads back the jig prompt and the working directory,
// then finishes a turn; the APCC-TC-056 journey launches it after a catalog
// install.
//
// Deliberately NOT named `agent`, which is what the Cursor CLI installs itself
// as: `importLoginShellEnv()` prepends `~/.local/bin` to the server's PATH, so a
// real Cursor install on a developer machine would win the lookup and the
// harness would drive the real CLI.
//
// Three behaviours, keyed on argv:
//
//   --version      print the build chosen by the file at CURSOR_VERSION_PATH
//                  and exit 0. The APCC-TC-052 journey writes that file
//                  (through e2e/agent-plugins/_support/cursor-version.ts) to
//                  install a build below the floor and then one inside the
//                  window. An absent or unreadable file reads as `within`, a
//                  build inside the overlay's declared window, so any other
//                  launch passes the pre-launch gate.
//   --list-models  print an excerpt of a real listing and exit 0. The excerpt
//                  keeps the real shape: the heading, a blank line, the
//                  `<id> - <label>` pairs, and the trailing tip line, so the
//                  host's `dash-line-pairs` reader has to skip the same
//                  non-pair lines it skips on a real run.
//   otherwise      write argv (everything after the script path) as JSON to
//                  CURSOR_ARGV_LOG_PATH and the working directory to
//                  CURSOR_CWD_LOG_PATH, print a ready line, and start a turn
//                  that keeps working until it is told to finish (see below).
//                  The process then idles, so the PTY session stays live and
//                  the host classifies no early-exit failure.
//
// Its own log path, for the reason roubo-e2e-codex-stub gives: each capture file
// is single-writer, last-write-wins, and the ambient claude overlay stays
// installed while this one is live.
//
// $ROUBO_E2E_AGENT_ARGV_LOG gates both writes but does not choose where they
// land: the destinations are the shared CURSOR_ARGV_LOG_PATH and
// CURSOR_CWD_LOG_PATH constants, imported below. An environment variable is
// untrusted input and must not steer a filesystem path. The two probe paths
// never write either log: they exit first, and the probe spawn
// strips every ROUBO_* variable from their environment.
//
// A WORKING TURN REDRAWS. The real CLI redraws about every 250ms while a turn
// runs, and the overlay's 3000ms quiescence fallback is measured against that.
// The stub writes a heartbeat every HEARTBEAT_MS for the same reason: a session
// that went silent would raise the fallback's waiting notification, and
// APCC-TC-046 has to tell the hook's notification apart from the fallback's.
//
// FINISHING A TURN. The launch writes a `stop` hook into the bench worktree's
// `.cursor/hooks.json` before the spawn. The spec cannot type into the session,
// so it finishes the turn by creating FINISH_TURN_FILE in the worktree, which is
// this process's working directory. The file name is a constant, not an
// environment variable, so nothing untrusted steers what is read. On sight the
// stub stops the heartbeat, lets the last write drain, and runs every
// `hooks.stop[].command` through a shell with a `stop` event on standard input,
// which is what the real CLI was measured doing. It writes nothing to the
// terminal after that: fresh output dismisses a waiting notification, and the
// real CLI emits nothing after `stop` either.

// ESM: the file has no extension, so Node resolves its module type from the
// nearest package.json, and roubo/package.json declares `"type": "module"`.
import { spawn } from "node:child_process";
import fs from "node:fs";
import path from "node:path";

import {
  CURSOR_ARGV_LOG_PATH,
  CURSOR_CWD_LOG_PATH,
} from "../../agent-plugins/_support/argv-log-path.mjs";
// The builds are defined once, next to the path, so this binary and the spec's
// expected versions cannot disagree.
import {
  CURSOR_BUILDS,
  CURSOR_VERSION_PATH,
} from "../../agent-plugins/_support/cursor-version-path.mjs";

// An excerpt of a recorded real `agent --list-models` listing, lines copied
// verbatim. Two `-high-fast` ids are kept, so the one APCC-TC-011 picks is not
// the only id that carries an effort and a speed.
const LISTING = [
  "Available models",
  "",
  "auto - Auto (current, default)",
  "gpt-5.3-codex-high - Codex 5.3 High",
  "gpt-5.3-codex-high-fast - Codex 5.3 High Fast",
  "composer-2.5 - Composer 2.5",
  "claude-opus-5-thinking-high-fast - Claude Opus 5 1M Thinking Fast",
  "",
  "Tip: use --model <id> (or /model <id> in interactive mode) to switch. Parameterized models also accept quoted overrides, e.g. --model 'claude-opus-4-8[context=1m,effort=high,fast=false]'.",
  "",
].join("\n");

/** Created in the worktree by the APCC-TC-046 spec to end the running turn. */
const FINISH_TURN_FILE = ".roubo-e2e-cursor-finish-turn";

/** The hook registration the launch wrote, relative to the worktree. */
const HOOKS_FILE = path.join(".cursor", "hooks.json");

const HEARTBEAT_MS = 250;
const TRIGGER_POLL_MS = 100;

/** A `stop` event, shaped like the payload the real CLI sends. */
const STOP_PAYLOAD = {
  conversation_id: "e2e-cursor-conversation",
  generation_id: "e2e-cursor-generation-1",
  model: "default",
  status: "completed",
  loop_count: 0,
  session_id: "e2e-cursor-conversation",
  hook_event_name: "stop",
};

const argv = process.argv.slice(2);

function readBuild() {
  try {
    const choice = fs.readFileSync(CURSOR_VERSION_PATH, "utf-8").trim();
    return CURSOR_BUILDS[choice] ?? CURSOR_BUILDS.within;
  } catch {
    return CURSOR_BUILDS.within;
  }
}

if (argv.includes("--version")) {
  process.stdout.write(`${readBuild()} (Roubo e2e stub)\n`);
  process.exit(0);
}

if (argv.includes("--list-models")) {
  process.stdout.write(LISTING);
  process.exit(0);
}

if (process.env.ROUBO_E2E_AGENT_ARGV_LOG) {
  try {
    fs.writeFileSync(CURSOR_ARGV_LOG_PATH, `${JSON.stringify(argv)}\n`, "utf-8");
  } catch (err) {
    process.stderr.write(`roubo-e2e-cursor-stub: could not write argv log: ${err.message}\n`);
  }
  try {
    fs.writeFileSync(CURSOR_CWD_LOG_PATH, `${process.cwd()}\n`, "utf-8");
  } catch (err) {
    process.stderr.write(`roubo-e2e-cursor-stub: could not write cwd log: ${err.message}\n`);
  }
}

/** Every stop-hook command the worktree's hooks file registers. */
function readStopCommands() {
  try {
    const parsed = JSON.parse(fs.readFileSync(HOOKS_FILE, "utf-8"));
    const stop = parsed?.hooks?.stop;
    if (!Array.isArray(stop)) return [];
    return stop.map((entry) => entry?.command).filter((command) => typeof command === "string");
  } catch {
    return [];
  }
}

/**
 * Run one hook command through a shell with the payload on stdin, as the real
 * CLI does. `/bin/sh` rather than `$SHELL`: the host shell-quotes the command
 * for any POSIX shell, and a fixed shell keeps a developer's shell startup out
 * of the run. Its output is discarded, never forwarded to the terminal.
 */
function runHook(command) {
  return new Promise((resolve) => {
    const child = spawn("/bin/sh", ["-c", command], { stdio: ["pipe", "ignore", "ignore"] });
    child.on("error", () => resolve());
    child.on("close", () => resolve());
    child.stdin.on("error", () => {});
    child.stdin.end(`${JSON.stringify(STOP_PAYLOAD)}\n`);
  });
}

process.stdout.write("roubo-e2e-cursor-stub ready\n");

const frames = ["|", "/", "-", "\\"];
let frame = 0;
const heartbeat = setInterval(() => {
  process.stdout.write(`\rworking ${frames[frame % frames.length]}`);
  frame += 1;
}, HEARTBEAT_MS);

let finished = false;
const watcher = setInterval(async () => {
  if (finished || !fs.existsSync(FINISH_TURN_FILE)) return;
  finished = true;
  clearInterval(watcher);
  clearInterval(heartbeat);
  // Let the last heartbeat reach the host before the hook's notification does,
  // so that write cannot arrive after the notification and dismiss it.
  await new Promise((resolve) => setTimeout(resolve, 2 * HEARTBEAT_MS));
  for (const command of readStopCommands()) {
    await runHook(command);
  }
}, TRIGGER_POLL_MS);

// Idle. The spec destroys the session when it is done, and this timer keeps the
// event loop alive once the heartbeat and the watcher have stopped.
const keepAlive = setInterval(() => {}, 1000);

for (const signal of ["SIGTERM", "SIGINT", "SIGHUP"]) {
  process.on(signal, () => {
    clearInterval(keepAlive);
    clearInterval(heartbeat);
    clearInterval(watcher);
    process.exit(0);
  });
}
