#!/usr/bin/env node

// Stub agent CLI for the AP-TC-087 drift guard (issue #531).
//
// The `claude-code` bundled overlay (../bundled-overlays/claude-code/) points its
// launch descriptor and its version probe at this binary. It exists so the
// integrated launch can be observed from the CHILD's own argv rather than from a
// reconstruction on the host side: whatever `pty.spawn` hands this process is
// what `process.argv` reports, so an assertion over the captured array is direct
// evidence that the extra arguments reached the CLI as separate argv tokens with
// no shell interpretation (AP-TC-087 S008).
//
// Deliberately NOT named `claude`: `importLoginShellEnv()` prepends `~/.local/bin`
// to the server's PATH, so a real Claude Code install on a developer machine
// would win the lookup and the guard would silently drive the real CLI.
//
// Two behaviours, keyed on argv:
//
//   --version   print a version inside the overlay's declared compatibility
//               window and exit 0, so the pre-launch version gate resolves
//               `within-tested-range` and the launch proceeds.
//   otherwise   write argv (everything after the script path) as JSON to
//               AGENT_ARGV_LOG_PATH, then idle so the PTY session stays live and
//               the host classifies no early-exit failure.
//
// $ROUBO_E2E_AGENT_ARGV_LOG gates the write but does not choose where it lands:
// the destination is the shared AGENT_ARGV_LOG_PATH constant, imported below. An
// environment variable is untrusted input and must not steer a filesystem path.
//
// The version-probe path never writes the log: it exits before the write, and
// `runCommand` strips every ROUBO_* variable from the probe's environment, so
// $ROUBO_E2E_AGENT_ARGV_LOG is not even visible there.

// ESM: the file has no extension, so Node resolves its module type from the
// nearest package.json, and roubo/package.json declares `"type": "module"`.
import fs from "node:fs";

// The one file this stub will ever write. Defined once, in plain ESM, so this
// binary and the spec's TypeScript support module cannot disagree about where the
// argv lands: a drifted second copy would surface as a spec that reads no argv
// and blames the launch.
import { AGENT_ARGV_LOG_PATH } from "../../agent-plugins/_support/argv-log-path.mjs";

// Inside the overlay's declared window (floor 2.1.111, tested ceiling 2.1.207),
// so the gate neither blocks the launch nor emits a staleness notice.
const STUB_VERSION = "2.1.150";

const argv = process.argv.slice(2);

if (argv.includes("--version")) {
  process.stdout.write(`${STUB_VERSION} (Roubo e2e stub)\n`);
  process.exit(0);
}

if (process.env.ROUBO_E2E_AGENT_ARGV_LOG) {
  try {
    fs.writeFileSync(AGENT_ARGV_LOG_PATH, `${JSON.stringify(argv)}\n`, "utf-8");
  } catch (err) {
    process.stderr.write(`roubo-e2e-claude-stub: could not write argv log: ${err.message}\n`);
  }
}

// A line of output so the session reads as a live agent rather than a silent
// one, and so the early-exit classifier has captured output to work with if this
// process ever does die.
process.stdout.write("roubo-e2e-claude-stub ready\n");

// Idle. The spec destroys the session when it is done, and the timer is the only
// handle keeping the event loop alive, so an unref'd or cleared timer would end
// the process.
const keepAlive = setInterval(() => {}, 1000);

for (const signal of ["SIGTERM", "SIGINT", "SIGHUP"]) {
  process.on(signal, () => {
    clearInterval(keepAlive);
    process.exit(0);
  });
}
