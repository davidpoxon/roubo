{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "type": "object",
  "properties": {
    "$schema": {
      "type": "string",
      "const": "https://roubo.dev/schema/state-recipe/v1.0.0.json"
    },
    "schemaVersion": {
      "type": "string",
      "const": "1.0.0"
    },
    "caseId": {
      "type": "string",
      "minLength": 1
    },
    "unitId": {
      "type": "string",
      "minLength": 1
    },
    "commit": {
      "type": "string",
      "minLength": 1
    },
    "requires": {
      "type": "array",
      "items": {
        "type": "string",
        "minLength": 1
      }
    },
    "steps": {
      "type": "array",
      "items": {
        "oneOf": [
          {
            "type": "object",
            "properties": {
              "kind": {
                "type": "string",
                "const": "command"
              },
              "command": {
                "type": "string",
                "minLength": 1
              },
              "cwd": {
                "type": "string"
              },
              "env": {
                "type": "object",
                "propertyNames": {
                  "type": "string"
                },
                "additionalProperties": {
                  "type": "string"
                }
              },
              "timeoutMs": {
                "type": "integer",
                "exclusiveMinimum": 0,
                "maximum": 9007199254740991
              },
              "expectedExitCode": {
                "type": "integer",
                "minimum": 0,
                "maximum": 255
              }
            },
            "required": ["kind", "command"],
            "additionalProperties": {}
          },
          {
            "type": "object",
            "properties": {
              "kind": {
                "type": "string",
                "const": "copy-file"
              },
              "from": {
                "type": "string",
                "minLength": 1
              },
              "to": {
                "type": "string",
                "minLength": 1
              },
              "mode": {
                "type": "string",
                "enum": ["overwrite", "create-only"]
              }
            },
            "required": ["kind", "from", "to"],
            "additionalProperties": {}
          },
          {
            "type": "object",
            "properties": {
              "kind": {
                "type": "string",
                "const": "http"
              },
              "method": {
                "type": "string",
                "minLength": 1
              },
              "url": {
                "type": "string",
                "format": "uri"
              },
              "headers": {
                "type": "object",
                "propertyNames": {
                  "type": "string"
                },
                "additionalProperties": {
                  "type": "string"
                }
              },
              "body": {
                "type": "string"
              },
              "timeoutMs": {
                "type": "integer",
                "exclusiveMinimum": 0,
                "maximum": 9007199254740991
              },
              "expectedStatus": {
                "type": "integer",
                "minimum": 100,
                "maximum": 599
              }
            },
            "required": ["kind", "method", "url"],
            "additionalProperties": {}
          },
          {
            "type": "object",
            "properties": {
              "kind": {
                "type": "string",
                "const": "open-url"
              },
              "url": {
                "type": "string",
                "format": "uri"
              }
            },
            "required": ["kind", "url"],
            "additionalProperties": {}
          }
        ]
      }
    },
    "observation": {
      "type": "object",
      "properties": {
        "description": {
          "type": "string",
          "minLength": 1
        },
        "url": {
          "type": "string",
          "format": "uri"
        },
        "path": {
          "type": "string",
          "minLength": 1
        },
        "selector": {
          "type": "string",
          "minLength": 1
        }
      },
      "required": ["description"],
      "additionalProperties": {}
    }
  },
  "required": [
    "$schema",
    "schemaVersion",
    "caseId",
    "unitId",
    "commit",
    "requires",
    "steps",
    "observation"
  ],
  "additionalProperties": {},
  "$id": "https://roubo.dev/schema/state-recipe/v1.0.0.json",
  "title": "State recipe",
  "description": "How to put a checkout of one unit's commit into the state one test case observes (SB-FR-025): requirements, ordered steps of a known kind, and the observation to make."
}
