{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "type": "object",
  "properties": {
    "$schema": {
      "type": "string",
      "const": "https://roubo.dev/schema/delivery-control/v1.0.0.json"
    },
    "schemaVersion": {
      "type": "string",
      "const": "1.0.0"
    },
    "delivery_id": {
      "type": "string",
      "minLength": 1
    },
    "control_seq": {
      "type": "integer",
      "minimum": 1,
      "maximum": 9007199254740991
    },
    "kind": {
      "type": "string",
      "enum": [
        "decision-answer",
        "overturn",
        "steering-note",
        "role-change",
        "pause",
        "wind-down",
        "resume",
        "approval"
      ]
    },
    "target_id": {
      "type": "string",
      "minLength": 1
    },
    "body": {
      "type": "object",
      "propertyNames": {
        "type": "string"
      },
      "additionalProperties": {}
    },
    "issued_at": {
      "type": "string",
      "format": "date-time",
      "pattern": "^(?:(?:\\d\\d[2468][048]|\\d\\d[13579][26]|\\d\\d0[48]|[02468][048]00|[13579][26]00)-02-29|\\d{4}-(?:(?:0[13578]|1[02])-(?:0[1-9]|[12]\\d|3[01])|(?:0[469]|11)-(?:0[1-9]|[12]\\d|30)|(?:02)-(?:0[1-9]|1\\d|2[0-8])))T(?:(?:[01]\\d|2[0-3]):[0-5]\\d:[0-5]\\d(?:\\.\\d+)?(?:Z|([+-](?:[01]\\d|2[0-3]):[0-5]\\d)))$"
    },
    "status": {
      "type": "string",
      "minLength": 1
    }
  },
  "required": [
    "$schema",
    "schemaVersion",
    "delivery_id",
    "control_seq",
    "kind",
    "body",
    "issued_at",
    "status"
  ],
  "additionalProperties": {},
  "$id": "https://roubo.dev/schema/delivery-control/v1.0.0.json",
  "title": "Delivery control",
  "description": "One operator control of a spec delivery's outbox (SB-FR-014). `kind` names the control, `target_id` what it acts on; the body is an open object."
}
