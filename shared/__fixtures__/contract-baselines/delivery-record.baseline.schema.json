{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "type": "object",
  "properties": {
    "$schema": {
      "type": "string",
      "const": "https://roubo.dev/schema/delivery-record/v1.0.0.json"
    },
    "schemaVersion": {
      "type": "string",
      "const": "1.0.0"
    },
    "delivery_id": {
      "type": "string",
      "minLength": 1
    },
    "spec_slug": {
      "type": "string",
      "minLength": 1
    },
    "plan_hash": {
      "type": "string",
      "minLength": 1
    },
    "mode": {
      "type": "object",
      "properties": {
        "value": {
          "type": "string",
          "enum": ["attended", "auto"]
        },
        "pending": {
          "anyOf": [
            {
              "type": "string",
              "enum": ["attended", "auto"]
            },
            {
              "type": "null"
            }
          ]
        }
      },
      "required": ["value"],
      "additionalProperties": {}
    },
    "review": {
      "type": "object",
      "properties": {
        "status": {
          "type": "string",
          "enum": ["none", "pending", "open"]
        },
        "trigger": {
          "type": "string",
          "minLength": 1
        },
        "unreviewed": {
          "type": "array",
          "items": {
            "type": "string",
            "minLength": 1
          }
        }
      },
      "required": ["status", "unreviewed"],
      "additionalProperties": {}
    },
    "stack": {
      "type": "object",
      "properties": {
        "stacks": {
          "type": "object",
          "propertyNames": {
            "type": "string",
            "minLength": 1
          },
          "additionalProperties": {
            "minItems": 1,
            "type": "array",
            "items": {
              "type": "string",
              "minLength": 1
            }
          }
        },
        "gates": {
          "type": "array",
          "items": {
            "type": "object",
            "properties": {
              "id": {
                "type": "string",
                "minLength": 1
              },
              "after": {
                "minItems": 1,
                "type": "array",
                "items": {
                  "type": "string",
                  "minLength": 1
                }
              },
              "status": {
                "type": "string",
                "minLength": 1
              },
              "cases": {
                "type": "array",
                "items": {
                  "type": "string",
                  "minLength": 1
                }
              },
              "provisional": {
                "type": "boolean"
              },
              "provisionalCases": {
                "type": "array",
                "items": {
                  "type": "object",
                  "properties": {
                    "case": {
                      "type": "string",
                      "minLength": 1
                    },
                    "mark": {
                      "type": "string",
                      "enum": ["met", "not_met"]
                    },
                    "evidence": {
                      "type": "string",
                      "maxLength": 4000
                    },
                    "confirmed": {
                      "type": "boolean"
                    }
                  },
                  "required": ["case", "mark", "evidence", "confirmed"],
                  "additionalProperties": {}
                }
              }
            },
            "required": ["id", "after", "status", "cases"],
            "additionalProperties": {}
          }
        }
      },
      "required": ["stacks", "gates"],
      "additionalProperties": {}
    },
    "units": {
      "type": "array",
      "items": {
        "type": "object",
        "properties": {
          "id": {
            "type": "string",
            "minLength": 1
          },
          "title": {
            "type": "string"
          },
          "status": {
            "type": "string",
            "minLength": 1
          },
          "stack": {
            "type": "string",
            "minLength": 1
          },
          "layer": {
            "type": "integer",
            "minimum": 0,
            "maximum": 9007199254740991
          },
          "depends_on": {
            "type": "array",
            "items": {
              "type": "string",
              "minLength": 1
            }
          },
          "branch": {
            "type": "string"
          },
          "head": {
            "type": "string"
          },
          "cost_usd": {
            "type": "number",
            "minimum": 0
          }
        },
        "required": ["id", "title", "status", "stack", "layer", "depends_on"],
        "additionalProperties": {}
      }
    },
    "decisions": {
      "type": "array",
      "items": {
        "type": "object",
        "properties": {
          "id": {
            "type": "string",
            "minLength": 1
          },
          "question": {
            "type": "string",
            "minLength": 1
          },
          "options": {
            "minItems": 2,
            "type": "array",
            "items": {
              "type": "string",
              "minLength": 1
            }
          },
          "default": {
            "type": "string",
            "minLength": 1
          },
          "status": {
            "type": "string",
            "minLength": 1
          },
          "unit_id": {
            "type": "string",
            "minLength": 1
          },
          "raised_at": {
            "type": "string",
            "format": "date-time",
            "pattern": "^(?:(?:\\d\\d[2468][048]|\\d\\d[13579][26]|\\d\\d0[48]|[02468][048]00|[13579][26]00)-02-29|\\d{4}-(?:(?:0[13578]|1[02])-(?:0[1-9]|[12]\\d|3[01])|(?:0[469]|11)-(?:0[1-9]|[12]\\d|30)|(?:02)-(?:0[1-9]|1\\d|2[0-8])))T(?:(?:[01]\\d|2[0-3]):[0-5]\\d:[0-5]\\d(?:\\.\\d+)?(?:Z|([+-](?:[01]\\d|2[0-3]):[0-5]\\d)))$"
          },
          "author": {
            "type": "string",
            "minLength": 1
          },
          "chosen": {
            "type": "string",
            "minLength": 1
          },
          "rationale": {
            "type": "string",
            "maxLength": 4000
          },
          "affected_units": {
            "type": "array",
            "items": {
              "type": "string",
              "minLength": 1
            }
          },
          "review": {
            "type": "object",
            "properties": {
              "status": {
                "type": "string",
                "enum": ["unreviewed", "accepted", "overturned"]
              },
              "reviewer": {
                "type": "string",
                "minLength": 1
              },
              "summary": {
                "type": "string",
                "maxLength": 4000
              }
            },
            "required": ["status"],
            "additionalProperties": {}
          },
          "decided_at": {
            "type": "string",
            "format": "date-time",
            "pattern": "^(?:(?:\\d\\d[2468][048]|\\d\\d[13579][26]|\\d\\d0[48]|[02468][048]00|[13579][26]00)-02-29|\\d{4}-(?:(?:0[13578]|1[02])-(?:0[1-9]|[12]\\d|3[01])|(?:0[469]|11)-(?:0[1-9]|[12]\\d|30)|(?:02)-(?:0[1-9]|1\\d|2[0-8])))T(?:(?:[01]\\d|2[0-3]):[0-5]\\d:[0-5]\\d(?:\\.\\d+)?(?:Z|([+-](?:[01]\\d|2[0-3]):[0-5]\\d)))$"
          }
        },
        "required": ["id", "question", "options", "default", "status", "raised_at"],
        "additionalProperties": {}
      }
    },
    "steering": {
      "type": "array",
      "items": {
        "type": "object",
        "properties": {
          "id": {
            "type": "string",
            "minLength": 1
          },
          "note": {
            "type": "string",
            "minLength": 1
          },
          "unit_ids": {
            "type": "array",
            "items": {
              "type": "string",
              "minLength": 1
            }
          },
          "created_at": {
            "type": "string",
            "format": "date-time",
            "pattern": "^(?:(?:\\d\\d[2468][048]|\\d\\d[13579][26]|\\d\\d0[48]|[02468][048]00|[13579][26]00)-02-29|\\d{4}-(?:(?:0[13578]|1[02])-(?:0[1-9]|[12]\\d|3[01])|(?:0[469]|11)-(?:0[1-9]|[12]\\d|30)|(?:02)-(?:0[1-9]|1\\d|2[0-8])))T(?:(?:[01]\\d|2[0-3]):[0-5]\\d:[0-5]\\d(?:\\.\\d+)?(?:Z|([+-](?:[01]\\d|2[0-3]):[0-5]\\d)))$"
          }
        },
        "required": ["id", "note", "unit_ids", "created_at"],
        "additionalProperties": {}
      }
    },
    "budget": {
      "type": "object",
      "properties": {
        "estimate_usd": {
          "type": "number",
          "minimum": 0
        },
        "soft_budget_usd": {
          "type": "number",
          "minimum": 0
        },
        "spent_usd": {
          "type": "number",
          "minimum": 0
        }
      },
      "required": ["estimate_usd", "soft_budget_usd", "spent_usd"],
      "additionalProperties": {}
    },
    "roles": {
      "type": "object",
      "propertyNames": {
        "type": "string",
        "minLength": 1
      },
      "additionalProperties": {
        "type": "object",
        "properties": {
          "tier": {
            "type": "string",
            "minLength": 1
          }
        },
        "required": ["tier"],
        "additionalProperties": {}
      }
    },
    "health": {
      "type": "object",
      "properties": {
        "status": {
          "type": "string",
          "minLength": 1
        },
        "checked_at": {
          "type": "string",
          "format": "date-time",
          "pattern": "^(?:(?:\\d\\d[2468][048]|\\d\\d[13579][26]|\\d\\d0[48]|[02468][048]00|[13579][26]00)-02-29|\\d{4}-(?:(?:0[13578]|1[02])-(?:0[1-9]|[12]\\d|3[01])|(?:0[469]|11)-(?:0[1-9]|[12]\\d|30)|(?:02)-(?:0[1-9]|1\\d|2[0-8])))T(?:(?:[01]\\d|2[0-3]):[0-5]\\d:[0-5]\\d(?:\\.\\d+)?(?:Z|([+-](?:[01]\\d|2[0-3]):[0-5]\\d)))$"
        },
        "detail": {
          "type": "string"
        }
      },
      "required": ["status", "checked_at"],
      "additionalProperties": {}
    },
    "drift": {
      "type": "array",
      "items": {
        "type": "object",
        "properties": {
          "kind": {
            "type": "string",
            "minLength": 1
          },
          "detail": {
            "type": "string",
            "minLength": 1
          },
          "detected_at": {
            "type": "string",
            "format": "date-time",
            "pattern": "^(?:(?:\\d\\d[2468][048]|\\d\\d[13579][26]|\\d\\d0[48]|[02468][048]00|[13579][26]00)-02-29|\\d{4}-(?:(?:0[13578]|1[02])-(?:0[1-9]|[12]\\d|3[01])|(?:0[469]|11)-(?:0[1-9]|[12]\\d|30)|(?:02)-(?:0[1-9]|1\\d|2[0-8])))T(?:(?:[01]\\d|2[0-3]):[0-5]\\d:[0-5]\\d(?:\\.\\d+)?(?:Z|([+-](?:[01]\\d|2[0-3]):[0-5]\\d)))$"
          },
          "unit_id": {
            "type": "string",
            "minLength": 1
          }
        },
        "required": ["kind", "detail", "detected_at"],
        "additionalProperties": {}
      }
    },
    "seams": {
      "type": "object",
      "propertyNames": {
        "type": "string",
        "minLength": 1
      },
      "additionalProperties": {
        "type": "object",
        "properties": {
          "status": {
            "type": "string",
            "minLength": 1
          },
          "last_run_at": {
            "type": "string",
            "format": "date-time",
            "pattern": "^(?:(?:\\d\\d[2468][048]|\\d\\d[13579][26]|\\d\\d0[48]|[02468][048]00|[13579][26]00)-02-29|\\d{4}-(?:(?:0[13578]|1[02])-(?:0[1-9]|[12]\\d|3[01])|(?:0[469]|11)-(?:0[1-9]|[12]\\d|30)|(?:02)-(?:0[1-9]|1\\d|2[0-8])))T(?:(?:[01]\\d|2[0-3]):[0-5]\\d:[0-5]\\d(?:\\.\\d+)?(?:Z|([+-](?:[01]\\d|2[0-3]):[0-5]\\d)))$"
          },
          "detail": {
            "type": "string"
          }
        },
        "required": ["status"],
        "additionalProperties": {}
      }
    },
    "lifecycle": {
      "type": "object",
      "properties": {
        "state": {
          "type": "string",
          "minLength": 1
        },
        "armed": {
          "type": "boolean"
        },
        "started_at": {
          "type": "string",
          "format": "date-time",
          "pattern": "^(?:(?:\\d\\d[2468][048]|\\d\\d[13579][26]|\\d\\d0[48]|[02468][048]00|[13579][26]00)-02-29|\\d{4}-(?:(?:0[13578]|1[02])-(?:0[1-9]|[12]\\d|3[01])|(?:0[469]|11)-(?:0[1-9]|[12]\\d|30)|(?:02)-(?:0[1-9]|1\\d|2[0-8])))T(?:(?:[01]\\d|2[0-3]):[0-5]\\d:[0-5]\\d(?:\\.\\d+)?(?:Z|([+-](?:[01]\\d|2[0-3]):[0-5]\\d)))$"
        },
        "ended_at": {
          "anyOf": [
            {
              "type": "string",
              "format": "date-time",
              "pattern": "^(?:(?:\\d\\d[2468][048]|\\d\\d[13579][26]|\\d\\d0[48]|[02468][048]00|[13579][26]00)-02-29|\\d{4}-(?:(?:0[13578]|1[02])-(?:0[1-9]|[12]\\d|3[01])|(?:0[469]|11)-(?:0[1-9]|[12]\\d|30)|(?:02)-(?:0[1-9]|1\\d|2[0-8])))T(?:(?:[01]\\d|2[0-3]):[0-5]\\d:[0-5]\\d(?:\\.\\d+)?(?:Z|([+-](?:[01]\\d|2[0-3]):[0-5]\\d)))$"
            },
            {
              "type": "null"
            }
          ]
        }
      },
      "required": ["state", "armed", "started_at"],
      "additionalProperties": {}
    },
    "last_event_seq": {
      "type": "integer",
      "minimum": 0,
      "maximum": 9007199254740991
    },
    "updated_at": {
      "type": "string",
      "format": "date-time",
      "pattern": "^(?:(?:\\d\\d[2468][048]|\\d\\d[13579][26]|\\d\\d0[48]|[02468][048]00|[13579][26]00)-02-29|\\d{4}-(?:(?:0[13578]|1[02])-(?:0[1-9]|[12]\\d|3[01])|(?:0[469]|11)-(?:0[1-9]|[12]\\d|30)|(?:02)-(?:0[1-9]|1\\d|2[0-8])))T(?:(?:[01]\\d|2[0-3]):[0-5]\\d:[0-5]\\d(?:\\.\\d+)?(?:Z|([+-](?:[01]\\d|2[0-3]):[0-5]\\d)))$"
    }
  },
  "required": [
    "$schema",
    "schemaVersion",
    "delivery_id",
    "spec_slug",
    "plan_hash",
    "mode",
    "review",
    "stack",
    "units",
    "decisions",
    "steering",
    "budget",
    "roles",
    "health",
    "drift",
    "seams",
    "lifecycle",
    "last_event_seq",
    "updated_at"
  ],
  "additionalProperties": {},
  "$id": "https://roubo.dev/schema/delivery-record/v1.0.0.json",
  "title": "Delivery record",
  "description": "One document describing a spec delivery at a point in time (SB-FR-005). Unknown keys are kept: a minor version adds fields, a major version removes them."
}
