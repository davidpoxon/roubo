# Treat npm warnings as hard failures where npm supports it.
# Abort install if the active Node does not satisfy package.json "engines".
engine-strict=true
# Fail on peer dependency conflicts instead of silently auto-resolving them.
strict-peer-deps=true
# Record exact versions on `npm install <pkg>`. This repo pins every dependency
# exactly (lint:dep-pins), and without this Dependabot's lockfile regeneration
# writes a `^` range into package-lock.json while pinning package.json exactly.
save-exact=true
